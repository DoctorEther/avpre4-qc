@PointClass base(Targetname, Appearflags) size (16 16 24) color(30 200 35) = play_sound_triggered : "Custom sound player. Plays a clip a single time when triggered.


volume: 0.1 to 1. Default is 1 = full volume.
noise: path of sound to play, not including the /sound/ folder part. EG 'misc/talk.wav' for the message beep sound
impulse: sound channel. Default is 0 = Automatic.
speed: attenuation factor

spawnflags:
- Toggle: stops sound when triggered again.
- Looped: use in conjuction with the 'toggle' flag to create a looped sound you can toggle on/off.
- Play on activator: sound source will be whatever entity that's the activator (a monster for example).
- Play on player: forces the sound source to be a player - either the activator, or if the activator isn't a player, it'll look for the closest player.
- Play on all players: play the sound for all players.

NOTE - Sound files must be in the SOUND folder (or a sub folder under the SOUND folder.)"
	[
		spawnflags(flags) = [
			1 : "Toggle" : 0
			2 : "Looped" : 0
			4 : "Play on activator" : 0
			8 : "Play on player" : 0
			16 : "Play on all players" : 0
		]
		noise(string) : "Sound file to play"
		speed(choices) : "Attenuation of sound" : 1 =[
			-1 : "No attenuation (heard everywhere)"
			1  : "Normal (1024u)"
			2  : "Idle (512u)"
			3  : "Static (341u)"
		]
		volume(integer) : "Volume (decimal in the 0-1 range)" : 1
		impulse(integer) : "Channel (0 to 7). Leave at 0 for Automatic" : 0
		//wait(integer) : "Wait before retrigger" : 0 //Quoth2
	]


