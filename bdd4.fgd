[
	spawnflags(flags) =
	[
		1 : "Large box" : 0
		4 : "Infinite (never disappears)" : 0
	]
]

@PointClass
    base(Ammo)
    model(
        {{
            spawnflags & 1 ->   ":maps/b_batt1.bsp",
                                ":maps/b_batt0.bsp"
